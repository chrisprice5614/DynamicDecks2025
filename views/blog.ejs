<html lang="en">
<head>
    
    <%- include("includes/head") %>
    <title>Dynamic Decks, Inc</title>

    <style>
    .card {
        cursor: pointer;
        transition: all 0.3s ease;
        
        border-radius: 16px;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.6);
        text-shadow: 0px 0px 8px #000;
    }

    .card:hover {
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.6);
    }
    </style>
</head>
<%- include("includes/sticky") %>
<header>
    <%- include("includes/header") %>
</header>
<body>
    <main>
        <div class="content">
            <div></div>

            <div>
                <br>
                <h1 style="text-align: center; color: #fff; text-shadow: 0 0 12px rgba(0, 0, 0, 1);">Blog</h1>
                <br>
                <% blogs.forEach( blog => { %>
                    <div class="card" onclick="location.href='/blog/<%= blog.slug %>'" style="background-image: url('<%= blog.hero %>'); background-position: center; background-size: cover; background-repeat: no-repeat;">
                        <div style="background-color: rgba(0, 0, 0, 0.3); padding: 16px 32px; border-radius: 16px;">
                            <h1><a href="/blog/<%= blog.id %>" style="color: #fff; font-weight: 600; text-decoration: none; font-size: x-large;"><%= blog.page %></a></h1>
                        </div>
                    </div>
                    <br>
                <% }) %>
                <br>
            </div>

            <div></div>
        </div>
    </main>
</body>
<footer>
    <%- include("includes/footer") %>
</footer>
</html>