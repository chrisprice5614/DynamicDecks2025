<script>
function toggleMobileNav() {
    const nav = document.getElementById('mobile-nav');
    const btn = document.getElementById('hamburger-btn');
    const isOpen = nav.classList.toggle('open');
    btn.setAttribute('aria-expanded', isOpen);
}
document.addEventListener('click', function(e) {
    const nav = document.getElementById('mobile-nav');
    const btn = document.getElementById('hamburger-btn');
    const header = document.querySelector('.site-header');
    if (nav.classList.contains('open') && !header.contains(e.target)) {
        nav.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
    }
});

(function desktopServicesDropdown() {
    const dd = document.getElementById('nav-services-dropdown');
    if (!dd || window.matchMedia('(max-width: 900px)').matches) return;
    const toggle = document.getElementById('nav-services-toggle');
    let hideTimer = null;
    const CLOSE_DELAY_MS = 450;
    function open() {
        if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
        dd.classList.add('open');
        if (toggle) toggle.setAttribute('aria-expanded', 'true');
    }
    function scheduleClose() {
        if (hideTimer) clearTimeout(hideTimer);
        hideTimer = setTimeout(function () {
            dd.classList.remove('open');
            if (toggle) toggle.setAttribute('aria-expanded', 'false');
            hideTimer = null;
        }, CLOSE_DELAY_MS);
    }
    dd.addEventListener('mouseenter', open);
    dd.addEventListener('mouseleave', scheduleClose);
    dd.addEventListener('focusin', open);
    dd.addEventListener('focusout', function (e) {
        if (!dd.contains(e.relatedTarget)) scheduleClose();
    });
})();
</script>
