<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dynamic Decks – Analytics Report</title>
  <style>
    @page { size: A4; margin: 20mm 15mm; }
    :root { --ink:#0d0b0e; --muted:#6a6a78; --accent:#b026ff; --card:#f7f7fa; }
    html, body { margin:0; padding:0; color: var(--ink); font-family: "Open Sans", Arial, sans-serif; }
    h1,h2,h3 { font-family: "quicksand", sans-serif; font-weight: 700; margin: 0 0 8px; }
    h1 { font-size: 24px; }
    h2 { font-size: 18px; margin-top: 18px; }
    p, li { line-height: 1.5; }
    .subtle { color: var(--muted); }
    .card { background: var(--card); border: 1px solid #e4e4ea; border-radius: 8px; padding: 12px; }
    .grid2 { display:grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .grid3 { display:grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
    .section { page-break-inside: avoid; margin-bottom: 16px; }
    .page-break { page-break-after: always; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 8px; border-bottom: 1px solid #e9e9ef; font-size: 12px; }
    th { background: #f1f1f6; }
    .pill { display:inline-block; padding: 4px 8px; border-radius: 999px; background:#efe9ff; color:#4a2b8c; font-size: 12px; }
    .header { display:flex; justify-content: space-between; align-items:center; }
    .download { display:inline-block; padding: 8px 12px; border-radius: 8px; background: var(--accent); color:white; text-decoration:none; font-weight:700; }
  </style>
</head>
<body>
  <div class="section">
    <div class="header">
      <div>
        <h1>Dynamic Decks — Website Report</h1>
        <div class="subtle">Period: <%= metrics.window.start || 'N/A' %> → <%= metrics.window.end || 'N/A' %> (Last 30 days)</div>
      </div>
      <a class="download" href="/report.pdf">Download PDF</a>
    </div>
    <div class="grid3" style="margin-top:12px;">
      <div class="card">
        <h2>Monthly Sessions</h2>
        <div style="font-size: 28px; font-weight:800;"><%= metrics.month.totals.totalSessions %></div>
        <div class="subtle">Visits recorded in the last 30 days</div>
      </div>
      <div class="card">
        <h2>Monthly Conversions</h2>
        <div style="font-size: 28px; font-weight:800;"><%= metrics.month.totals.convertedSessions %></div>
        <div class="subtle">Thank-you visits in the last 30 days</div>
      </div>
      <div class="card">
        <h2>Monthly Conversion Rate</h2>
        <div style="font-size: 28px; font-weight:800;"><%= (metrics.month.totals.conversionRate * 100).toFixed(1) %>%</div>
        <div class="subtle">Monthly conversions ÷ sessions</div>
      </div>
    </div>
    <div class="grid3" style="margin-top:12px;">
      <div class="card">
        <h3>Contact Page Sessions</h3>
        <div><strong><%= metrics.month.funnel.sessionsWithContact %></strong></div>
        <div class="subtle">Sessions that viewed /contact (monthly)</div>
      </div>
      <div class="card">
        <h3>Request Page Sessions</h3>
        <div><strong><%= metrics.month.funnel.sessionsWithRequest %></strong></div>
        <div class="subtle">Sessions that viewed /request (monthly)</div>
      </div>
      <div class="card">
        <h3>Career Page Sessions</h3>
        <div><strong><%= metrics.month.funnel.sessionsWithCareer %></strong></div>
        <div class="subtle">Sessions that viewed /career (monthly)</div>
      </div>
    </div>
    <div class="grid3" style="margin-top:12px;">
      <div class="card">
        <h3>Avg Pages/Session (Monthly)</h3>
        <div><strong><%= metrics.month.totals.avgPagesPerSession.toFixed(2) %></strong></div>
      </div>
      <div class="card">
        <h3>Bounce Rate (Monthly)</h3>
        <div><strong><%= (metrics.month.totals.bounceRate * 100).toFixed(1) %>%</strong></div>
      </div>
      <div class="card">
        <h3>All-time Avg Pages</h3>
        <div><strong><%= metrics.totals.avgPagesPerSession.toFixed(2) %></strong></div>
      </div>
    </div>
  </div>

  <div class="page-break"></div>

  <div class="section">
    <h2>Recent Activity</h2>
    <div class="grid3">
      <div class="card">
        <div class="pill">Last 7 days</div>
        <div style="margin-top:8px;">Sessions: <strong><%= metrics.ranges.last7 %></strong></div>
        <div>Conversions: <strong><%= metrics.ranges.conv7 %></strong></div>
      </div>
      <div class="card">
        <div class="pill">Last 30 days</div>
        <div style="margin-top:8px;">Sessions: <strong><%= metrics.ranges.last30 %></strong></div>
        <div>Conversions: <strong><%= metrics.ranges.conv30 %></strong></div>
      </div>
      <div class="card">
        <div class="pill">Last 90 days</div>
        <div style="margin-top:8px;">Sessions: <strong><%= metrics.ranges.last90 %></strong></div>
        <div>Conversions: <strong><%= metrics.ranges.conv90 %></strong></div>
      </div>
    </div>
    <div class="card" style="margin-top:12px;">
      <h3>Daily Sessions & Conversions (Last 30 days)</h3>
      <table>
        <thead><tr><th>Day</th><th>Sessions</th><th>Conversions</th></tr></thead>
        <tbody>
          <% if (metrics.timeSeries.length === 0) { %>
            <tr><td colspan="3" class="subtle">No day-level session data available.</td></tr>
          <% } else { %>
            <% metrics.timeSeries.forEach(function(r){ %>
              <tr><td><%= r.day %></td><td><%= r.sessions %></td><td><%= r.conversions %></td></tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="page-break"></div>

   <div class="section">
    <h2>Top Pages (Monthly)</h2>
    <table>
      <thead>
        <tr><th>URL</th><th>Visits</th></tr>
      </thead>
      <tbody>
        <% if (metrics.month.pages.length === 0) { %>
          <tr><td colspan="2" class="subtle">No page visit data recorded yet.</td></tr>
        <% } else { %>
          <% metrics.month.pages.forEach(function(p){ %>
            <tr>
              <td><%= p.url %></td>
              <td><%= p.count %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="section">
    <h2>Entry Pages (Monthly)</h2>
    <table>
      <thead>
        <tr><th>URL</th><th>Sessions Started</th></tr>
      </thead>
      <tbody>
        <% if (metrics.month.entries.length === 0) { %>
          <tr><td colspan="2" class="subtle">No entry page data recorded yet.</td></tr>
        <% } else { %>
          <% metrics.month.entries.forEach(function(p){ %>
            <tr><td><%= p.url %></td><td><%= p.count %></td></tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="section">
    <h2>Exit Pages (Monthly)</h2>
    <table>
      <thead>
        <tr><th>URL</th><th>Sessions Ended</th></tr>
      </thead>
      <tbody>
        <% if (metrics.month.exits.length === 0) { %>
          <tr><td colspan="2" class="subtle">No exit page data recorded yet.</td></tr>
        <% } else { %>
          <% metrics.month.exits.forEach(function(p){ %>
            <tr><td><%= p.url %></td><td><%= p.count %></td></tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="page-break"></div>

  <div class="section">
    <h2>Keyword Insights</h2>
    <p class="subtle">Extracted from headers and content across pages and active blogs. Useful for SEO focus and ad targeting.</p>
    <table>
      <thead>
        <tr><th>Keyword</th><th>Frequency</th></tr>
      </thead>
      <tbody>
        <% metrics.keywords.forEach(function(k){ %>
          <tr>
            <td><%= k.word %></td>
            <td><%= k.count %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="section">
    <h2>Top Phrases (Bigrams)</h2>
    <table>
      <thead>
        <tr><th>Phrase</th><th>Frequency</th></tr>
      </thead>
      <tbody>
        <% metrics.bigrams.forEach(function(k){ %>
          <tr><td><%= k.phrase %></td><td><%= k.count %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="page-break"></div>

  <div class="section">
    <h2>Assets & Content</h2>
    <div class="grid2">
      <div class="card">
        <h3>Gallery Images</h3>
        <p><strong><%= metrics.totals.imageCount %></strong> images in gallery.</p>
      </div>
      <div class="card">
        <h3>Form Activity</h3>
        <p>Tracked by conversions (thank-you visits). Current total: <strong><%= metrics.totals.convertedSessions %></strong>.</p>
        <p class="subtle">If you want detailed form submission counts by type, I can wire additional tracking to the contact and career forms.</p>
      </div>
    </div>
    <div class="grid2" style="margin-top:12px;">
      <div class="card">
        <h3>Avg Pages/Session (All-time)</h3>
        <p><strong><%= metrics.totals.avgPagesPerSession.toFixed(2) %></strong></p>
      </div>
      <div class="card">
        <h3>Bounce Rate (All-time)</h3>
        <p><strong><%= (metrics.totals.bounceRate * 100).toFixed(1) %>%</strong></p>
      </div>
    </div>
    <div class="card" style="margin-top:12px;">
      <h3>Gallery Categories</h3>
      <table>
        <thead><tr><th>Category</th><th>Count</th></tr></thead>
        <tbody>
          <% Object.entries(metrics.gallery.categories).forEach(function(entry){ %>
            <tr><td><%= entry[0] %></td><td><%= entry[1] %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="page-break"></div>

  <div class="section">
    <h2>Pages Summary</h2>
    <table>
      <thead><tr><th>Page</th><th>Header chars</th><th>Content chars</th><th>Hero?</th></tr></thead>
      <tbody>
        <% metrics.content.pages.forEach(function(p){ %>
          <tr>
            <td><%= p.page %></td>
            <td><%= p.headerChars %></td>
            <td><%= p.contentChars %></td>
            <td><%= p.hero ? 'Yes' : 'No' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="section">
    <h2>Blogs Summary</h2>
    <div class="subtle">Total: <%= metrics.content.totalBlogs %> • Active: <%= metrics.content.activeBlogs %></div>
    <table>
      <thead><tr><th>ID</th><th>Slug</th><th>Header chars</th><th>Content chars</th><th>Active?</th><th>Hero?</th></tr></thead>
      <tbody>
        <% metrics.content.blogs.slice(0, 50).forEach(function(b){ %>
          <tr>
            <td><%= b.id %></td>
            <td><%= b.slug %></td>
            <td><%= b.headerChars %></td>
            <td><%= b.contentChars %></td>
            <td><%= b.active ? 'Yes' : 'No' %></td>
            <td><%= b.hero ? 'Yes' : 'No' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

</body>
</html>
