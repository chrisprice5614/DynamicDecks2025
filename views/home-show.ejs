<html lang="en">
<head>
    <%- include("includes/head") %>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <% const headUrl = "https://www.dynamicdecksinc.com/home-show" %>
    <% const headDescription = "Visit Dynamic Decks at the Spokane Home & Garden Show. Talk to our experts about decks, pergolas, and outdoor living spaces." %>
    <% const headTitle = "Dynamic Decks | Spokane Home Show" %>

    <title><%= headTitle %></title>
    <meta name="title" content="<%= headTitle %>">
    <meta name="description" content="<%= headDescription %>">
    <link rel="canonical" href="<%= headUrl %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= headUrl %>">
    <meta property="og:title" content="<%= headTitle %>">
    <meta property="og:description" content="<%= headDescription %>">
    <meta property="og:site_name" content="Dynamic Decks">
    <meta name="theme-color" content="#22B8F5">
</head>
<%- include("includes/sticky") %>
<header><%- include("includes/header") %></header>

<body>

<div class="page-hero" style="background-image: url('/img/ui/wood-bckg.webp'); min-height: 220px;">
    <div class="page-hero-content">
        <h1>Spokane Home Show</h1>
        <p>Come find us at the Spokane Convention Center!</p>
    </div>
</div>

<section class="section section-warm">
    <div class="container">
        <div class="contact-wrap">
            <div class="contact-info">
                <div style="text-align: center; margin-bottom: 28px;">
                    <a href="https://spokanehomeshows.com/spokane-home-garden-show/" target="_blank">
                        <img src="/img/ui/homeAndGardenSpokane.webp" alt="Spokane Home and Garden Show" style="width: 100%; max-width: 500px; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);">
                    </a>
                </div>
                <h2>See Us at the Spokane Home &amp; Garden Show</h2>
                <p>Come out and see us at the <strong>Spokane Home &amp; Garden Show</strong> at the Spokane Convention Center. Our experts will be on hand to answer questions about custom decks, pergolas, covers, and turning your outdoor living ideas into reality.</p>

                <div class="contact-detail">
                    <div class="contact-detail-icon"><ion-icon name="location-outline"></ion-icon></div>
                    <div class="contact-detail-text">
                        <h4>Venue</h4>
                        <p>Spokane Convention Center<br>Spokane, WA</p>
                    </div>
                </div>
                <div class="contact-detail">
                    <div class="contact-detail-icon"><ion-icon name="call-outline"></ion-icon></div>
                    <div class="contact-detail-text">
                        <h4>Questions?</h4>
                        <p><a href="tel:5094643325">(509) 464-3325</a></p>
                    </div>
                </div>
            </div>

            <div class="form-card">
                <h2>Get in Touch</h2>
                <p class="form-sub">Send us a message and we'll follow up after the show.</p>
                <form action="/contact" method="POST" name="HomeShowForm">
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text" name="name" placeholder="John Doe" required>
                    </div>
                    <div class="form-group">
                        <label>Phone Number</label>
                        <input id="phoneNumber" type="tel" name="phone" maxlength="16" placeholder="(509) 555-1234" required>
                    </div>
                    <div class="form-group">
                        <label>Address</label>
                        <input type="text" name="address" placeholder="Your project address" required>
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" name="email" placeholder="you@example.com" required>
                    </div>
                    <div class="form-group">
                        <label>Message</label>
                        <textarea name="message" placeholder="Tell us about your project..."></textarea>
                    </div>
                    <div class="g-recaptcha" data-sitekey="6Lchm2ErAAAAAGGXkJ9ane8BFngVnsa8tXF_PofO" style="margin-bottom: 20px;"></div>
                    <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center; font-size:15px; padding:16px;">
                        <ion-icon name="send-outline"></ion-icon>
                        Send Message
                    </button>
                    <p style="font-size: 12px; color: var(--text-muted); text-align:center; margin-top:12px;">
                        Your info is private. <a href="/privacy-policy" style="color: var(--accent);">Privacy Policy</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

</body>
<footer><%- include("includes/footer") %></footer>
</html>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const phoneInput = document.getElementById('phoneNumber');
    if (!phoneInput) return;
    phoneInput.addEventListener('input', (e) => {
        let value = e.target.value.replace(/\D/g, '').slice(0, 10);
        if (value.length > 6) value = `(${value.slice(0,3)}) ${value.slice(3,6)}-${value.slice(6)}`;
        else if (value.length > 3) value = `(${value.slice(0,3)}) ${value.slice(3)}`;
        else if (value.length > 0) value = `(${value}`;
        e.target.value = value;
    });
});
</script>
