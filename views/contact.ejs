<html lang="en">
<head>
    <%- include("includes/head") %>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <% const headUrl = "https://www.dynamicdecksinc.com/contact" %>
    <% const headDescription = "Contact Dynamic Decks for a free estimate on your custom deck, pergola, or outdoor project in Spokane, WA. Call (509) 464-3325 or fill out our form." %>
    <% const headTitle = "Contact Dynamic Decks | Free Deck Estimate | Spokane, WA" %>

    <title><%= headTitle %></title>
    <meta name="title" content="<%= headTitle %>">
    <meta name="description" content="<%= headDescription %>">
    <link rel="canonical" href="<%= headUrl %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= headUrl %>">
    <meta property="og:title" content="<%= headTitle %>">
    <meta property="og:description" content="<%= headDescription %>">
    <meta property="og:site_name" content="Dynamic Decks">
    <meta name="theme-color" content="#22B8F5">
</head>
<%- include("includes/sticky") %>
<header><%- include("includes/header") %></header>

<body>

<!-- PAGE HERO -->
<div class="page-hero" style="background-image: url('/img/ui/wood-bckg.webp'); min-height: 240px;">
    <div class="page-hero-content">
        <h1>Contact Us</h1>
        <p>Get a free, no-obligation estimate on your project</p>
    </div>
</div>

<!-- CONTACT SECTION -->
<section class="section section-warm">
    <div class="container">
        <div class="contact-wrap">
            <!-- Info Side -->
            <div class="contact-info">
                <h2>Let's Build Something Great</h2>
                <p>Ready to transform your outdoor space? We'd love to hear about your project. Fill out the form and we'll get back to you quickly, or give us a call!</p>

                <div class="contact-detail">
                    <div class="contact-detail-icon"><ion-icon name="call-outline"></ion-icon></div>
                    <div class="contact-detail-text">
                        <h4>Phone</h4>
                        <p><a href="tel:5094643325">(509) 464-3325</a></p>
                    </div>
                </div>
                <div class="contact-detail">
                    <div class="contact-detail-icon"><ion-icon name="location-outline"></ion-icon></div>
                    <div class="contact-detail-text">
                        <h4>Location</h4>
                        <p>1720 E Houston Ave<br>Spokane, WA 99217</p>
                    </div>
                </div>
                <div style="margin-top: 32px; padding: 24px; background-color: var(--bg-white); border-radius: var(--radius-lg); border-left: 4px solid var(--accent); box-shadow: var(--shadow-sm);">
                    <div class="success-icon-wrap" style="width: 44px; height: 44px; margin-bottom: 8px;"><ion-icon name="shield-checkmark-outline" aria-hidden="true"></ion-icon></div>
                    <h4 style="margin-bottom: 6px;">Our Promise</h4>
                    <p style="color: var(--text-muted); font-size: 14px; margin: 0;">We stand behind our work completely.</p>
                </div>
            </div>

            <!-- Form Side -->
            <div class="form-card">
                <h2>Request a Free Estimate</h2>
                <p class="form-sub">We typically respond within 1 business day.</p>
                <form action="/contact" method="POST" name="ContactForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Name</label>
                            <input type="text" name="name" placeholder="John Doe" required>
                        </div>
                        <div class="form-group">
                            <label>Phone Number</label>
                            <input id="phoneNumber" type="tel" name="phone" maxlength="16" placeholder="(509) 555-1234" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Project Address</label>
                        <input type="text" name="address" placeholder="Where is the project located?" required>
                    </div>
                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" name="email" placeholder="you@example.com" required>
                    </div>
                    <div class="form-group">
                        <label>Tell Us About Your Project</label>
                        <textarea name="message" placeholder="Describe your dream deck, pergola, or outdoor space..."></textarea>
                    </div>
                    <div class="g-recaptcha" data-sitekey="6Lchm2ErAAAAAGGXkJ9ane8BFngVnsa8tXF_PofO" style="margin-bottom: 20px;"></div>
                    <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center; font-size:15px; padding:16px;">
                        <ion-icon name="send-outline"></ion-icon>
                        Send My Request
                    </button>
                    <p style="font-size: 12px; color: var(--text-muted); text-align:center; margin-top:12px;">
                        Your information is kept private. <a href="/privacy-policy" style="color: var(--accent);">Privacy Policy</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

</body>
<footer><%- include("includes/footer") %></footer>
</html>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const phoneInput = document.getElementById('phoneNumber');
    if (!phoneInput) return;
    phoneInput.addEventListener('input', (e) => {
        let value = e.target.value.replace(/\D/g, '').slice(0, 10);
        if (value.length > 6) value = `(${value.slice(0,3)}) ${value.slice(3,6)}-${value.slice(6)}`;
        else if (value.length > 3) value = `(${value.slice(0,3)}) ${value.slice(3)}`;
        else if (value.length > 0) value = `(${value}`;
        e.target.value = value;
    });
});
</script>
