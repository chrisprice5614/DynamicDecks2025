<html lang="en">
<head>
    <%- include("includes/head") %>
    <%
        const baseUrl = "https://www.dynamicdecksinc.com/";
        const validPages = ["decks", "pergolas", "covers", "construction"];
        const headUrl = validPages.includes(pageData.page) ? `${baseUrl}${pageData.page}` : `${baseUrl}blog/${pageData.slug}`;
    %>
    <% const headDescription = "Dynamic Decks builds durable, custom outdoor decks, pergolas, and covers with premium materials for lasting beauty and year-round outdoor living enjoyment." %>
    <% const headTitle = `Dynamic Decks - ${pageData.header}` %>

    <title><%= headTitle %></title>
    <meta name="title" content="<%= headTitle %>">
    <meta name="description" content="<%= headDescription %>">
    <meta name="keywords" content="decks, washington decks, deck builder, deck builder spokane, spokane decks">
    <link rel="canonical" href="<%= headUrl %>">

    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= headUrl %>">
    <meta property="og:title" content="<%= headTitle %>">
    <meta property="og:description" content="<%= headDescription %>">
    <meta property="og:site_name" content="Dynamic Decks">
    <meta property="og:locale" content="en_US">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="theme-color" content="#22B8F5">
</head>
<%- include("includes/sticky") %>
<header><%- include("includes/header") %></header>

<body>

<!-- PAGE HERO -->
<div class="page-hero" style="background-image: url('<%= pageData.hero || "/img/ui/wood-bckg.webp" %>');">
    <div class="page-hero-content">
        <h1><%= pageData.header %></h1>
    </div>
</div>

<!-- CONTENT -->
<div class="page-wrapper">
    <div class="container">
        <div class="content-card">
            <div class="page-content" style="padding: 0;">
                <%- pageData.content %>
            </div>
        </div>
    </div>
</div>

<!-- CTA BAND -->
<section class="cta-band section-dark">
    <div class="container">
        <h2>Interested in This Service?</h2>
        <p>Let's talk about your project. Get a free estimate today.</p>
        <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
            <a href="/contact" class="btn btn-primary btn-lg">
                <ion-icon name="document-text-outline"></ion-icon>
                Get a Free Quote
            </a>
            <a href="/gallery" class="btn btn-secondary btn-lg">
                <ion-icon name="images-outline"></ion-icon>
                View Our Gallery
            </a>
        </div>
    </div>
</section>

</body>
<footer><%- include("includes/footer") %></footer>
</html>

<script>
function reveal() {
    document.querySelectorAll(".reveal").forEach(el => {
        if (el.getBoundingClientRect().top < window.innerHeight - 40) {
            el.classList.add("active");
        }
    });
    numberAnimate();
}
function numberAnimate() {
    document.querySelectorAll(".number-animate").forEach(el => {
        if (!el.classList.contains("counted")) {
            const rect = el.getBoundingClientRect();
            if (rect.top < window.innerHeight - 20) {
                el.classList.add("counted");
                const finalValue = parseInt(el.getAttribute("data-val"));
                const duration = 1200, stepTime = 16;
                const increment = finalValue / (duration / stepTime);
                let current = 0;
                const timer = setInterval(() => {
                    current += increment;
                    if (current >= finalValue) { el.textContent = finalValue; clearInterval(timer); }
                    else el.textContent = Math.ceil(current);
                }, stepTime);
            }
        }
    });
}
window.addEventListener("scroll", reveal);
window.addEventListener("load", reveal);
</script>
