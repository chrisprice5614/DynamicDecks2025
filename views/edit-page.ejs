<html lang="en">
<head>
    
    <%- include("includes/head") %>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <title>Dynamic Decks, Inc</title>
</head>
<%- include("includes/sticky") %>
<header>
    
    <%- include("includes/header") %>
</header>
<body>
    <main>
        <h1 style="text-align: center;">
            Edit <%= pageData.header %>
        </h1>
        <br>
        <div class="page-content">
            <form method="POST" action="/edit/<%= id %>" enctype="multipart/form-data" class="contact-form">
                <label for="header">header</label>
                <input 
                type="text" 
                id="header" 
                name="header" 
                placeholder="Enter blog header..." 
                required
                value="<%= pageData.header.replace(/"/g, '&quot;') %>"
                >

                <!-- Hero Image Upload -->
                <label for="heroImage">Hero Image</label>
                <% if (pageData.hero) { %>
                    <div style="margin-bottom: 8px;">
                        <img src="<%= pageData.hero %>" alt="Current Hero" style="max-width: 100%; border-radius: 8px;">
                    </div>
                <% } %>
                <input type="file" id="heroImage" name="heroImage" accept="image/*">
                <br>
                <br>
                <label for="markdown">Content</label>
                <textarea 
                id="markdown" 
                name="content" 
                placeholder="Write Markdown here..." 
                required
                rows="10"
                ><%= pageData.content %></textarea>

                <!-- Image Upload UI -->
                <label for="imageUpload">Insert Image</label>
                <input type="file" id="imageUpload" accept="image/*">
                <br>
                <button type="button" onclick="uploadImage()">Upload & Insert</button>

                <br><br>

                <button type="submit">Save <%= pageData.header %></button>

                <br><br>

                
            </form>
            <br>
            <div class="preview" id="preview"></div>
        </div>
    </main>
    <script>
    const textarea = document.getElementById("markdown");
    const preview = document.getElementById("preview");

    // Live preview the raw HTML directly
    textarea.addEventListener("input", () => {
        preview.innerHTML = textarea.value;
    });

    // Initialize preview on page load
    preview.innerHTML = textarea.value;

    async function uploadImage() {
        const fileInput = document.getElementById("imageUpload");
        const file = fileInput.files[0];

        if (!file) return alert("Please select an image");

        const formData = new FormData();
        formData.append("image", file);

        try {
            const res = await fetch("/upload-markdown-image", {
                method: "POST",
                body: formData,
            });

            const data = await res.json();
            if (data.error) throw new Error(data.error);

            // Insert <img> tag directly into HTML content
            const cursor = textarea.selectionStart;
            const htmlImage = `<img src="${data.url}" alt="Image">`;
            const text = textarea.value;
            textarea.value = text.substring(0, cursor) + htmlImage + text.substring(cursor);

            preview.innerHTML = textarea.value;
        } catch (err) {
            alert("Upload failed: " + err.message);
        }
    }
</script>
</body>
<footer>
    <%- include("includes/footer") %>
</footer>
</html>
