<html lang="en">
<head>
    <%- include("includes/head") %>
    <title>Admin Login | Dynamic Decks</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#22B8F5">
</head>
<%- include("includes/sticky") %>
<header><%- include("includes/header") %></header>

<body>
<div class="success-page">
    <div>
        <div class="success-icon-wrap"><ion-icon name="lock-closed-outline" aria-hidden="true"></ion-icon></div>
        <h1>Admin Login</h1>
        <p>Enter the admin password to access the dashboard.</p>
        <% if (typeof error !== 'undefined') { %>
            <p style="color: #c0392b; font-size: 15px; margin-bottom: 16px;"><%= error %></p>
        <% } %>
        <form action="/login" method="POST" style="max-width: 360px; margin: 0 auto; text-align: left;">
            <div class="form-group">
                <label for="password">Password</label>
                <input id="password" name="password" type="password" placeholder="Enter password" required autofocus>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center;">
                <ion-icon name="log-in-outline"></ion-icon>
                Sign In
            </button>
        </form>
    </div>
</div>
</body>
<footer><%- include("includes/footer") %></footer>
</html>
