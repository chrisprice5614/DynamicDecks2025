<script>
function reveal() {
    document.querySelectorAll(".reveal").forEach(el => {
        if (el.getBoundingClientRect().top < window.innerHeight - 40) {
            el.classList.add("active");
        }
    });
    numberAnimate();
}
function numberAnimate() {
    document.querySelectorAll(".number-animate").forEach(el => {
        if (!el.classList.contains("counted")) {
            const rect = el.closest('.stat-item') ? el.closest('.stat-item').getBoundingClientRect() : el.getBoundingClientRect();
            if (rect.top < window.innerHeight - 20) {
                el.classList.add("counted");
                const finalValue = parseInt(el.getAttribute("data-val"));
                const duration = 1200;
                const stepTime = 16;
                const steps = duration / stepTime;
                const increment = finalValue / steps;
                let current = 0;
                const timer = setInterval(() => {
                    current += increment;
                    if (current >= finalValue) {
                        el.textContent = finalValue;
                        clearInterval(timer);
                    } else {
                        el.textContent = Math.ceil(current);
                    }
                }, stepTime);
            }
        }
    });
}
window.addEventListener("scroll", reveal);
window.addEventListener("load", reveal);

document.addEventListener('DOMContentLoaded', () => {
    const phoneInput = document.getElementById('phoneNumberHome');
    if (!phoneInput) return;
    phoneInput.addEventListener('input', (e) => {
        let value = e.target.value.replace(/\D/g, '').slice(0, 10);
        if (value.length > 6) value = `(${value.slice(0,3)}) ${value.slice(3,6)}-${value.slice(6)}`;
        else if (value.length > 3) value = `(${value.slice(0,3)}) ${value.slice(3)}`;
        else if (value.length > 0) value = `(${value}`;
        e.target.value = value;
    });
});
</script>
