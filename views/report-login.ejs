<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Report Access</title>
  <style>
    :root {
      --bg: #0f0f12;
      --card: #17171c;
      --text: #e8e8ea;
      --accent: #b026ff;
    }
    html, body { margin:0; padding:0; background:var(--bg); color:var(--text); font-family: "Open Sans", Arial, sans-serif; }
    .wrap { max-width: 520px; margin: 80px auto; padding: 24px; background: var(--card); border-radius: 10px; box-shadow: 0 6px 20px rgba(0,0,0,.25); }
    h1 { margin: 0 0 8px; font-family: "quicksand", sans-serif; font-weight: 700; }
    p { opacity: .85; }
    form { margin-top: 16px; display: grid; gap: 12px; }
    input[type="password"] { padding: 12px; border-radius: 8px; border: 1px solid #2a2a31; background: #0c0c10; color: var(--text); }
    button { padding: 12px; border-radius: 8px; border: none; background: var(--accent); color: white; font-weight: 700; cursor: pointer; }
    button:hover { filter: brightness(1.05); }
    .err { margin-top: 10px; color: #ff8aa0; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>Secure Report</h1>
    <p>Enter the report password to view and download the PDF.</p>
    <% if (typeof error !== 'undefined') { %>
      <div class="err"><%= error %></div>
    <% } %>
    <form action="/report-login" method="POST">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" placeholder="Enter password" required />
      <button type="submit">Unlock Report</button>
    </form>
  </div>
</body>
</html>
