<html lang="en">
<head>
    <%- include("includes/head") %>
    <% const headUrl = "https://www.dynamicdecksinc.com/gallery" %>
    <% const headDescription = "Browse Dynamic Decks' project gallery: custom decks, pergolas, covers, railings, and specialty outdoor projects built in Spokane, WA." %>
    <% const headTitle = "Dynamic Decks - Project Gallery | Spokane Deck Builder" %>
    <% const galleryPhotosForScript = images.map(img => ({ src: '/img/gallery/' + img.path, caption: img.description || '' })); %>

    <title><%= headTitle %></title>
    <meta name="title" content="<%= headTitle %>">
    <meta name="description" content="<%= headDescription %>">
    <meta name="keywords" content="deck gallery, spokane deck photos, deck builder portfolio, pergola gallery spokane">
    <link rel="canonical" href="<%= headUrl %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= headUrl %>">
    <meta property="og:title" content="<%= headTitle %>">
    <meta property="og:description" content="<%= headDescription %>">
    <meta property="og:site_name" content="Dynamic Decks">
    <meta name="theme-color" content="#22B8F5">
</head>
<%- include("includes/sticky") %>
<header><%- include("includes/header") %></header>

<body>

<!-- PAGE HERO -->
<div class="page-hero" style="background-image: url('/img/ui/wood-bckg.webp'); min-height: 260px;">
    <div class="page-hero-content">
        <h1>Project Gallery</h1>
        <p>Over 1,000 projects completed across the Spokane area</p>
    </div>
</div>

<!-- GALLERY SECTION -->
<section class="section section-warm">
    <div class="container">

        <!-- Filter Bar -->
        <div class="gallery-filter-bar">
            <a href="/gallery" class="filter-btn <%= query == null ? 'active' : '' %>">All Projects</a>
            <a href="/gallery?filter=decks" class="filter-btn <%= query == 'decks' ? 'active' : '' %>">Decks</a>
            <a href="/gallery?filter=pergola" class="filter-btn <%= query == 'pergola' ? 'active' : '' %>">Pergolas</a>
            <a href="/gallery?filter=cover" class="filter-btn <%= query == 'cover' ? 'active' : '' %>">Covers</a>
            <a href="/gallery?filter=privacywall" class="filter-btn <%= query == 'privacywall' ? 'active' : '' %>">Privacy Walls</a>
            <a href="/gallery?filter=stairs" class="filter-btn <%= query == 'stairs' ? 'active' : '' %>">Stairs</a>
            <a href="/gallery?filter=railing" class="filter-btn <%= query == 'railing' ? 'active' : '' %>">Railing</a>
            <a href="/gallery?filter=lighting" class="filter-btn <%= query == 'lighting' ? 'active' : '' %>">Lighting</a>
        </div>

        <!-- Admin Upload Form -->
        <% if(user) { %>
        <div class="admin-card" style="margin-bottom: 32px;">
            <div class="admin-card-header">
                <h2>Upload Photo</h2>
            </div>
            <form action="/upload" method="POST" enctype="multipart/form-data">
                <div class="form-row">
                    <div class="form-group">
                        <label>Photo File</label>
                        <input type="file" id="file" name="file" accept=".png,.jpg,.jpeg" required style="padding: 8px;">
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <input type="text" name="description" placeholder="e.g. White composite deck with pergola" required>
                    </div>
                </div>
                <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
                    <label style="display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer; text-transform:none;">
                        <input type="checkbox" name="pergola" value="pergola"> Pergola
                    </label>
                    <label style="display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer; text-transform:none;">
                        <input type="checkbox" name="cover" value="cover"> Cover
                    </label>
                    <label style="display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer; text-transform:none;">
                        <input type="checkbox" name="privacywall" value="privacywall"> Privacy Wall
                    </label>
                    <label style="display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer; text-transform:none;">
                        <input type="checkbox" name="decks" value="decks"> Decks
                    </label>
                    <label style="display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer; text-transform:none;">
                        <input type="checkbox" name="stairs" value="stairs"> Stairs
                    </label>
                    <label style="display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer; text-transform:none;">
                        <input type="checkbox" name="railing" value="railing"> Railing
                    </label>
                    <label style="display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer; text-transform:none;">
                        <input type="checkbox" name="lighting" value="lighting"> Lighting
                    </label>
                </div>
                <button type="submit" class="btn btn-primary galleryButton">
                    <ion-icon name="cloud-upload-outline"></ion-icon>
                    Add to Gallery
                </button>
            </form>
        </div>
        <% } %>

        <% if(images.length === 0) { %>
        <div style="text-align:center; padding: 60px 20px; color: var(--text-muted);">
            <div class="success-icon-wrap" style="margin: 0 auto 16px; width: 64px; height: 64px;"><ion-icon name="images-outline" aria-hidden="true"></ion-icon></div>
            <h3>No photos in this category yet</h3>
            <p style="margin-top: 8px;">Check back soon or <a href="/gallery" style="color: var(--accent);">view all projects</a>.</p>
        </div>
        <% } else { %>
        <div class="gallery-grid" id="galleryGrid" data-gallery-root>
            <% images.forEach((image, gi) => { %>
            <div class="gallery-item" data-gallery-index="<%= gi %>" tabindex="0" role="button" aria-label="Open photo preview">
                <div class="gallery-item-inner">
                    <img
                        class="gallery-thumb"
                        src="/img/gallery/<%= image.path %>"
                        alt="<%= image.description %>"
                        loading="lazy"
                        decoding="async"
                        fetchpriority="low"
                        sizes="(max-width: 480px) 100vw, (max-width: 900px) 50vw, 33vw"
                    >
                    <div class="gallery-item-overlay" aria-hidden="true"></div>
                </div>
                <% if(user) { %>
                <a href="/delete/<%= image.id %>" class="gallery-delete-btn" onclick="event.stopPropagation(); return confirm('Delete this photo?');" title="Delete photo">
                    <ion-icon name="trash-outline"></ion-icon>
                </a>
                <% } %>
            </div>
            <% }) %>
        </div>
        <% } %>
    </div>
</section>

<script type="application/json" id="gallery-photos-data"><%- JSON.stringify(galleryPhotosForScript).replace(/</g, '\\u003c') %></script>

<!-- LIGHTBOX -->
<div class="lightbox-overlay" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo preview">
    <button type="button" class="lightbox-close" onclick="closeLightbox()" aria-label="Close">
        <ion-icon name="close-outline"></ion-icon>
    </button>
    <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" onclick="galleryStep(-1)" aria-label="Previous photo">
        <ion-icon name="chevron-back-outline"></ion-icon>
    </button>
    <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" onclick="galleryStep(1)" aria-label="Next photo">
        <ion-icon name="chevron-forward-outline"></ion-icon>
    </button>
    <div class="lightbox-stage">
        <img class="lightbox-img" id="lightbox-img" alt="">
    </div>
    <div class="lightbox-caption" id="lightbox-caption"></div>
</div>

<!-- CTA -->
<section class="cta-band section-dark">
    <div class="container">
        <h2>Like What You See?</h2>
        <p>Get your own custom deck or outdoor project started today with a free estimate.</p>
        <a href="/contact" class="btn btn-primary btn-lg">
            <ion-icon name="document-text-outline"></ion-icon>
            Request a Free Quote
        </a>
    </div>
</section>

<footer><%- include("includes/footer") %></footer>

<script>
(function () {
    var dataEl = document.getElementById('gallery-photos-data');
    var gallerySlides = [];
    if (dataEl && dataEl.textContent) {
        try { gallerySlides = JSON.parse(dataEl.textContent); } catch (e) { gallerySlides = []; }
    }

    var lightboxIndex = 0;

    window.openLightbox = function (index) {
        var lb = document.getElementById('lightbox');
        var img = document.getElementById('lightbox-img');
        var cap = document.getElementById('lightbox-caption');
        var prev = document.getElementById('lightbox-prev');
        var next = document.getElementById('lightbox-next');
        if (!lb || !img || !gallerySlides.length) return;
        lightboxIndex = Math.max(0, Math.min(index, gallerySlides.length - 1));
        var slide = gallerySlides[lightboxIndex];
        img.src = slide.src;
        img.alt = 'Gallery photo';
        cap.textContent = '';
        lb.classList.add('open');
        document.body.style.overflow = 'hidden';
        var single = gallerySlides.length < 2;
        if (prev) prev.style.display = single ? 'none' : '';
        if (next) next.style.display = single ? 'none' : '';
    };

    window.closeLightbox = function () {
        var lb = document.getElementById('lightbox');
        var img = document.getElementById('lightbox-img');
        if (!lb || !img) return;
        lb.classList.remove('open');
        document.body.style.overflow = '';
        img.removeAttribute('src');
    };

    window.galleryStep = function (delta) {
        if (!gallerySlides.length) return;
        lightboxIndex = (lightboxIndex + delta + gallerySlides.length) % gallerySlides.length;
        window.openLightbox(lightboxIndex);
    };

    var grid = document.getElementById('galleryGrid');
    if (grid) {
        grid.querySelectorAll('.gallery-item[data-gallery-index]').forEach(function (el) {
            function open(ev) {
                if (ev) ev.preventDefault();
                var i = parseInt(el.getAttribute('data-gallery-index'), 10);
                if (!isNaN(i)) window.openLightbox(i);
            }
            el.addEventListener('click', open);
            el.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    open(e);
                }
            });
        });
        grid.querySelectorAll('img.gallery-thumb').forEach(function (imgEl) {
            function markLoaded() { imgEl.classList.add('is-loaded'); }
            if (imgEl.complete && imgEl.naturalWidth > 0) markLoaded();
            else imgEl.addEventListener('load', markLoaded, { once: true });
            imgEl.addEventListener('error', markLoaded, { once: true });
        });
    }

    var lb = document.getElementById('lightbox');
    if (lb) {
        lb.addEventListener('click', function (e) {
            if (e.target.closest('.lightbox-stage')) return;
            if (e.target.closest('.lightbox-caption')) return;
            if (e.target.closest('.lightbox-nav')) return;
            if (e.target.closest('.lightbox-close')) return;
            window.closeLightbox();
        });
    }

    document.addEventListener('keydown', function (e) {
        var lbEl = document.getElementById('lightbox');
        if (!lbEl || !lbEl.classList.contains('open')) return;
        if (e.key === 'Escape') window.closeLightbox();
        if (e.key === 'ArrowLeft') window.galleryStep(-1);
        if (e.key === 'ArrowRight') window.galleryStep(1);
    });
})();

document.addEventListener('DOMContentLoaded', function () {
    var scrollpos = localStorage.getItem('galleryScroll');
    if (scrollpos) {
        window.scrollTo(0, parseInt(scrollpos, 10));
        localStorage.removeItem('galleryScroll');
    }
});
document.querySelectorAll('.gallery-delete-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
        localStorage.setItem('galleryScroll', window.scrollY);
    });
});
</script>

</body>
</html>
